import java.util.Scanner;

class BankTransaction extends Thread {
    int amount;

    public BankTransaction(int amount) {
        this.amount = amount;
    }

    @Override
    public void run() {
        if (this.getPriority() == Thread.MAX_PRIORITY) {
            System.out.println("High-value transaction processed first");
        } else if (this.getPriority() == Thread.MIN_PRIORITY) {
            System.out.println("Low-value transaction processed later");
        }
    }
}

public class Main {
    public static void main(String[] args) {
        System.out.println("Transaction1: ₹5000");
        System.out.println("Transaction2: ₹50000\n");

        BankTransaction transaction1 = new BankTransaction(5000);
        BankTransaction transaction2 = new BankTransaction(50000);

        transaction1.setPriority(Thread.MIN_PRIORITY); 
        
        transaction2.setPriority(Thread.MAX_PRIORITY); 

        transaction1.start();
        transaction2.start();
    }
}
