import java.util.HashSet;
import java.util.Scanner;

public class Attendance {
    private HashSet<String> attendanceSet;

    public Attendance() {
        attendanceSet = new HashSet<>();
    }

    public void markAttendance(String name) {
        if (attendanceSet.add(name)) {
            System.out.println("Attendance marked for " + name);
        } else {
            System.out.println(name + " is already marked present");
        }
    }

    public void displayAttendance() {
        System.out.println("\n--- Final Attendance List ---");
        if (attendanceSet.isEmpty()) {
            System.out.println("No one is present.");
        } else {
            for (String student : attendanceSet) {
                System.out.println("• " + student);
            }
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Attendance todayAttendance = new Attendance();

        System.out.println("Student Attendance System (Type 'exit' to finish)");
        System.out.println("-------------------------------------------------");

        while (true) {
            System.out.print("Enter name to mark attendance: ");
            String name = scanner.nextLine().trim();

            if (name.equalsIgnoreCase("exit")) {
                break;
            }

            if (!name.isEmpty()) {
                todayAttendance.markAttendance(name);
            }
        }

        todayAttendance.displayAttendance();
        scanner.close();
    }
}
